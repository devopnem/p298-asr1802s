config ipsec tunnel
    option enable '0'
    option description 'tunnel'
    option dpd_delay '30'
    option src_addr '127.0.0.1'
    option remote_addr '0.0.0.0'
    option ike_exchange_type 'ikev1'
    option aggressive_mode 'no'
    option local_subnets '0.0.0.0/0'
    option remote_subnets '0.0.0.0/0'
    option ike_lifetime '3600'
    option ike_encryption 'aes128'
    option ike_hash 'sha1'
    option ike_gh_group 'modp1024'
    option ipsec_lifetime '3600'
    option ipsec_encryption 'aes128'
    option ipsec_hash 'sha1'
    option ipsec_pfs 'none'
    option authentication 'psk'
    option pre_shared_key 'none'
    option debug '0'
    option ipsec_mode 'tunnel'
	
