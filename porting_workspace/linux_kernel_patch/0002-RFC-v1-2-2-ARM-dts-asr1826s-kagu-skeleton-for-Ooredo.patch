@@ -0,0 +1,40 @@
+# Porting Ooredoo R291 v2 to mainline Linux + OpenWrt
+
+Status: **RFC / bootstrap.** Everything below is grounded in runtime extraction
+from a **shipping unit** (root shell via paramiko + U‑Boot env + bit‑exact
+`rootfs-a.bin`/`kernel-a.bin` backups), not from the vendor source tree.
+
+## المهم أولاً — الحالة الحقيقية (verified)
+| البند | القيمة | المصدر |
+|---|---|---|
+| SoC | ASR ASR1802S — ARMv7‑Cortex‑A9 (0xc07)، 1 core | `/proc/cpuinfo`, `kernel-a.bin` strings |
+| DT compatible | `asr,1802s-evb` ، `asr,1802s` | `/proc/device-tree/compatible` |
+| رأس الصفحة | `ASR 1826s(KAGU) Board EVB` | `/proc/device-tree/model` |
+| RAM | 128 MB (32 MB CP carve‑out @0x06000000) | bootargs |
+| Flash | SPI‑NAND F35UQA001G 128 MB، 25 bank A/B+UBI | dmesg + /proc/mtd |
+| UART | ttyS0 115200n8 → pxa2xx‑uart @ d4017000 irq 59 | /proc/iomem + dmesg |
+| WiFi | RTL8812FE ×2 PCIe gen1x1 → rtl8192cd.ko (3 MB binary‑only) | dmesg; **binary لا يعمل على kernel جديد** |
+| Eth | ASR MAC @ d4281800 irq 42/43 + YT9215 switch | dmesg + iomem |
+| VoIP | MAX1919/SLIC (GPIO23/24) | dmesg |
+| USB3 | DWC3 irq 76 + USB3 PHY @ c0030000 | dmesg + iomem |
+| MMC | mmc0 @ d4280000 irq 71 | dmesg + iomem |
+| PMIC | 88PM802 I2C@0x30 (i2c@d4037000 irq 12089) | dmesg |
+| U‑Boot | bootcmd=`mrvlboot`، bootdelay=1، verify=no، loadaddr=0x8000 | mtd21 env |
+| dropbear_password | 19222019 (U‑Boot env) | mtd21 env |
+| OpenWrt | BB 14.07 r47068 mmp/asr1826s fork؛ /bin/opkg موجود | /etc/openwrt_release |
+
+## لماذا «ليس مدعوماً»؟
+- **ASR1802S غير موجود في kernel.org** — كل الـ drivers على الـ kernel 3.10 vendor fork (clock/reset/pinctrl/irq/SPI‑NAND/PCIe/eth/USB) مُضمّنة بالـ binary kernel وليست .ko.
+- **`rtl8192cd` binary‑only** → لا ينقل للـ >=5.13؛ البديل `rtw88` (يدعم 8812FE).
+
+## المسار إلى الـ upstream (phases)
+- **Phase A — proof (هذا المستودع):** DTS binding + skeleton DTS + RFC cover letter ← **ملفّات جاهزة الآن**.
+- **Phase B — SoC port to linux:** أرسل minimal SoC skeleton (clock/reset/pinctrl/irq/timer) إلى `linux-arm@`. **مطلوب:** مصدر kernel 3.4.x/3.10 vendor OR register‑by‑register reverse; دعم الـ community.
+- **Phase C — board DTS + peripherhals:** أضف full board DTS (`asr1826s-kagu`) + WiFi rtw88 + YT9215 DSA + SLIC + USB + MMC.
+- **Phase D — OpenWrt:** أعد إنشاء target `asr1826s`/`asr1802s` في `target/linux/` (Makefile.skeleton مرفق).
+
+## كيف تجريب (بلا فلاش NAND)
+1. UART على `pxa2xx-uart`؛ سجل boot log.
+2. بناء initramfs.itb armv7a‑cortex‑a9 و`tftpboot 0x8000 …; bootm` — proof إن الـ SoC يوثّق.
+
+> ملاحظة أمان: لم نلمس MTD/Flash؛ كل التحقق read‑only مع `ooredoo_backup/` كاسترداد احتياطي.
diff --git a/arch/arm/boot/dts/asr1802s.dtsi b/arch/arm/boot/dts/asr1802s.dtsi
new file mode 100644
index 0000000..98f428c
--- /dev/null
+++ b/arch/arm/boot/dts/asr1802s.dtsi
@@ -0,0 +1,42 @@
+// SPDX-License-Identifier: GPL-2.0
+/*
+ * ASR1802S SoC skeleton — RFC.
+ * The real clock/reset/pinctrl/irqchip/timer definitions must come from the
+ * vendor kernel 3.10 sources (ASR/Marvell) before this can boot a mainline
+ * kernel.  What we know from runtime extraction (3.10.33):
+ *   - single Cortex-A9 (arch 0xc07); L1 PIPT/VIPT caches; neon/vfpv3
+ *   - APB bus @0xd4000000, AXI periphs @0xd4200000 (see board DTS)
+ *   - irqbank via on-SoC ICU (IRQs listed in /proc/interrupts)
+ *   - timer: local-timer irq 45; arch timer
+ */
+/dts-v1/;
+/ {
+        #address-cells = <1>;
+        #size-cells = <1>;
+
+        cpus {
+                #address-cells = <1>;
+                #size-cells = <0>;
+                cpu: cpu@0 {
+                        device_type = "cpu";
+                        compatible = "arm,cortex-a9";
+                        reg = <0>;
+                };
+        };
+
+        soc {
+                compatible = "simple-bus";
+                #address-cells = <1>;
+                #size-cells = <1>;
+                /*
+                 * Placeholder for:
+                 *   - clk: asr1802s clock controller
+                 *   - reset: asr1802s reset controller
+                 *   - pinctrl: gpio banks / pinmux
+                 *   - intc: on-SoC ICU interrupt controller (parent of IRQs)
+                 *   - timer: local-timer + arch_timer
+                 * These must replace the vendor fork's marvell/asr primitives.
+                 */
+                #ifdef ASR1802S_UPSTREAM_SOC   /* filled after SoC port lands */
+        };
+};
diff --git a/arch/arm/boot/dts/asr1826s-kagu.dts b/arch/arm/boot/dts/asr1826s-kagu.dts
new file mode 100644
index 0000000..f8796b9
--- /dev/null
+++ b/arch/arm/boot/dts/asr1826s-kagu.dts
@@ -0,0 +1,140 @@
+// SPDX-License-Identifier: GPL-2.0
+/*
+ * Skeleton Device Tree for Ooredoo R291 v2 (ASR 1826s / KAGU).
+ *
+ * SoC : ASR1802S (ARMv7-Cortex-A9), 128 MiB RAM, 32 MiB CP carve-out.
+ * All MMIO / IRQ / partition values were read at runtime from a shipping
+ * unit (kernel 3.10.33 vendor): /proc/iomem, /proc/interrupts, /proc/mtd
+ * and U-Boot env (mtd21 bootargs).  Peripheral driver compatible strings
+ * are RFC placeholders pending the ASR1802S SoC port to mainline.
+ */
+
+/dts-v1/;
+#include "asr1802s.dtsi"   /* <-- to be added: clock/reset/pinctrl DDR/ICU */
+
+/ {
+        model = "Ooredoo R291 v2 (ASR 1826s / KAGU)";
+        compatible = "asr,1802s-evb", "asr,1802s";
+
+        aliases {
+                serial0 = &uart0;
+                mmc0    = &mmc0;
+        };
+
+        chosen {
+                stdout-path = "serial0";
+                bootargs = "console=ttyS0,115200 earlyprintk mem=128M "
+                              "cpmem=32M@0x6000000 "
+                              "rootfstype=squashfs root=/dev/mtdblk15 "
+                              "rootwait";
+        };
+
+        memory {
+                device_type = "memory";
+                /* 0x00000000 - 0x07ffffff : 128 MiB */
+                reg = <0x00000000 0x08000000>;
+        };
+
+        reserved-memory {
+                #address-cells = <1>;
+                #size-cells = <1>;
+                ranges;
+                /* cpmem=32M@0x06000000 reserved for the Communication Processor */
+                cp_reserved: buffer@6000000 {
+                        reg = <0x06000000 0x02000000>;
+                        no-map;
+                };
+        };
+
+        soc {
+                compatible = "simple-bus";
+                #address-cells = <1>;
+                #size-cells = <1>;
+                ranges = <0xd4000000 0xd4000000 0x2000000>,  /* APB */
+                         <0xd4200000 0xd4200000 0x1000000>,  /* AXI periphs */
+                         <0xd8000000 0xd8000000 0x0400000>,  /* PCIe wlan0 MMIO */
+                         <0xe0000000 0xe0000000 0x0400000>;  /* PCIe wlan1 MMIO */
+
+                /* UART0 / serial console */
+                uart0: serial@d4017000 {
+                        compatible = "mrvl,pxa2xx-uart";
+                        reg = <0xd4017000 0x100>;
+                        interrupts = <59>;
+                        clock-frequency = <100000000>;
+                        status = "okay";
+                };
+
+                /* QSPI -> SPI-NAND F35UQA001G (25 MTD banks in /proc/mtd) */
+                qspi: spi@...... {
+                        compatible = "asr,kagu-qspi";
+                        reg = <0xd401b000 0x1000>,
+                              <0xd420b000 0x1000>;        /* qspi + qspi-ctrl */
+                        interrupts = <35 77>;              /* asr-spi.0 ، qspi */
+                        #address-cells = <1>;
+                        #size-cells = <0>;
+                        /*
+                         * Partition map (from /proc/mtd — keep in sync):
+                         *   00 bootloader        0x040000
+                         *   01 cp_reliabledata  0x020000  (U-Boot env + CP NVM)
+                         *   05/06 mep-ota (+bk)
+                         *   07/08 dtim-a/dtim-b 0x040000
+                         *   09/10 cpimage-a/b   0x00f00000
+                         *   11/12 u-boot-a/b    0x0c0000
+                         *   13/14 kernel-a/b    0x0500000
+                         *   15/16 rootfs-a/b    0x01400000  <- /dev/root = rootfs-a
+                         *   17/18 oem_data-a/b  0x00600000
+                         *   21 bootargs         0x00040000
+                         *   23 rootfs_data      0x018c0000  (UBI volume)
+                         */
+                };
+
+                /* ASR Ethernet MAC + YT9215 switch */
+                eth: ethernet@d4281800 {
+                        compatible = "asr,kagu-eth";
+                        reg = <0xd4281800 0x1000>;
+                        interrupts = <42 43>;   /* eth0 RX/TX */
+                        /* DSA/YT9215 on the MDIO bus (br-lan) */
+                        #address-cells = <1>;
+                        #size-cells = <0>;
+                        status = "okay";
+                };
+
+                /* MMC0 */
+                mmc0: mmc@...... {
+                        compatible = "asr,kagu-mmc";
+                        reg = <0xd4280000 0x1000>;
+                        interrupts = <71>;
+                        status = "okay";
+                };
+
+                /* USB3 DW3 */
+                usb0: xhci@... {
+                        compatible = "asr,kagu-dwc3";
+                        reg = <0xc0000000 0x1000>;
+                        interrupts = <76>;
+                };
+
+                /* I2C.2 -> PMIC 88PM802 @0x30 */
+                i2c2: i2c@d4037000 {
+                        compatible = "asr,kagu-i2c";
+                        reg = <0xd4037000 0x1000>;
+                        interrupts = <86>;
+                        /* #address-cells=<1>; #size-cells=<0>; */
+                        /* pmic: 88pm80x@30 { compatible = "marvell,88pm802"; }; */
+                };
+
+                /* SLIC VoIP (MAX1919) — GPIO23 reset, GPIO24 wakeup */
+                slic: slic@... { /* maxlinear,max1919 */ };
+        };
+
+        /* Two PCIe Gen1x1 endpoints -> RTL8812FE wlan0/wlan1 */
+        pci {
+                compatible = "asr,kagu-pcie";
+                #address-cells = <3>;
+                #interrupt-cells = <1>;
+                /* wlan0 @ 0xd8200000 irq 26 ; wlan1 @ 0xe0100000 irq 250 */
+        };
+
+        /* MAC addresses / identity come from the per-unit TTPCom NVM
+         * under /overlay/root/NVM/ — preserve across any reflash. */
+};
