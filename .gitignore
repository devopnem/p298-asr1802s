*.bin
*.sqf
*.img
*.tar.gz
*.extracted/
# Common temp/log files
*.log
.tmp/
# Exclude compressed archives
*.zip
*.tar
*.rar
*.gz
# Exclude logs
*.log
logs/
# Python compile cache
__pycache__/
*.pyc
